# ==============================================================================
# กกท. (SAT) ระบบรับสมัครผู้เข้ารับการอบรมออนไลน์ - Environment Variables
# ==============================================================================
# สำเนาไฟล์นี้เป็น .env.local สำหรับรันบนเครื่องตนเอง (Local Development)
# หรือนำค่าเหล่านี้ไปกรอกใน Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. Supabase Configuration (เชื่อมต่อฐานข้อมูล & Storage)
# ได้จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Admin Security
# รหัส PIN 6 หลักสำหรับเข้าสู่ระบบผู้ดูแลระบบ (ค่าเริ่มต้น: 336699)
NEXT_PUBLIC_ADMIN_PIN=336699

# 3. Application URL (สำหรับสร้าง QR Code และลิงก์อ้างอิง)
NEXT_PUBLIC_SITE_URL=http://localhost:3009
